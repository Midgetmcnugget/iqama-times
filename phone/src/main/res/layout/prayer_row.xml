<?xml version="1.0" encoding="utf-8"?>
<!-- One row of prayers: name, adhan (bold) and iqamah underneath. Default texts are sample
     times for the widget picker preview. Included by both widget layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="1dp"
            android:paddingEnd="1dp">

            <TextView
                android:id="@+id/name0"
                android:layout_width="match_parent"
                android:layout_height="15dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Fajr"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/adhan0"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:fontFamily="sans-serif-medium"
                android:autoSizeMaxTextSize="19sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="05:33"
                android:textColor="#FFFFFF"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/iqamah0"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginTop="2dp"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="06:45"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

