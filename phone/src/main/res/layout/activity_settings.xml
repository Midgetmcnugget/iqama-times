<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar + scrolling settings. The root is padded for the status/navigation bars and the
     keyboard in code, so nothing sits underneath them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:title="@string/app_name" />

  <ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/mosque_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mosque_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/mosque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="0"
                android:imeOptions="actionDone"
                android:inputType="textUri" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/mosque_help" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/show_name" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_sunrise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/show_sunrise" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/clock12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/clock_12h" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="20dp"
            android:text="@string/appearance_label" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/appearance_help" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/colour_name"
            style="@style/SettingsHelp" />

        <TextView
            android:id="@+id/opacity_label"
            style="@style/SettingsLabel"
            android:layout_marginTop="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="16dp"
            android:text="@string/iqamah_offset_label" />

        <Spinner
            android:id="@+id/iqamah_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="8dp"
            android:text="@string/maghrib_offset_label" />

        <Spinner
            android:id="@+id/maghrib_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/iqamah_offset_help" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save_refresh" />

        <Button
            android:id="@+id/exact"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/allow_exact" />

        <TextView
            android:id="@+id/exact_help"
            style="@style/SettingsHelp"
            android:text="@string/allow_exact_help" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <TextView
            style="@style/SettingsHelp"
            android:layout_marginTop="16dp"
            android:text="@string/add_widget_help" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
