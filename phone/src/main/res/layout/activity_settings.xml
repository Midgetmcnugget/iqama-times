<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/mosque_label" />

        <EditText
            android:id="@+id/mosque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mosque_hint"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/mosque_help" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/show_name" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/clock12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/clock_12h" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="16dp"
            android:text="@string/iqamah_offset_label" />

        <Spinner
            android:id="@+id/iqamah_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="8dp"
            android:text="@string/maghrib_offset_label" />

        <Spinner
            android:id="@+id/maghrib_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/iqamah_offset_help" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save_refresh" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <TextView
            style="@style/SettingsHelp"
            android:layout_marginTop="16dp"
            android:text="@string/add_widget_help" />
    </LinearLayout>
</ScrollView>
