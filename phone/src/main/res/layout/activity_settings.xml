<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar + scrolling settings. The root is padded for the status/navigation bars and the
     keyboard in code, so nothing sits underneath them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

  <com.google.android.material.appbar.MaterialToolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:title="@string/app_name" />

  <ScrollView
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/mosque_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/mosque_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/mosque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="0"
                android:imeOptions="actionDone"
                android:inputType="textCapWords|textNoSuggestions" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/find_mosque"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/find_mosque" />

        <TextView
            android:id="@+id/mosque_help"
            style="@style/SettingsHelp"
            android:text="@string/mosque_help" />

        <TextView
            android:id="@+id/search_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/show_name" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/show_sunrise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/show_sunrise" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/clock12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/clock_12h" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="20dp"
            android:text="@string/look_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/style_glass"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_glass" />

            <Button
                android:id="@+id/style_strip"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/style_strip" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/style_help"
            style="@style/SettingsHelp" />

        <LinearLayout
            android:id="@+id/glass_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/font_label">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:completionThreshold="0"
                    android:imeOptions="actionDone"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/font_help"
                style="@style/SettingsHelp"
                android:text="@string/font_help" />

            <TextView
                style="@style/SettingsLabel"
                android:layout_marginTop="12dp"
                android:text="@string/picture_label" />

            <TextView
                android:id="@+id/picture_name"
                style="@style/SettingsHelp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/pick_picture"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pick_picture" />

                <Button
                    android:id="@+id/remove_picture"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/remove_picture" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="20dp"
            android:text="@string/text_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/size_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/size_small"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/size_small" />

            <Button
                android:id="@+id/size_medium"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/size_medium" />

            <Button
                android:id="@+id/size_large"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/size_large" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="12dp"
            android:text="@string/names_label" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/names_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <Button
                android:id="@+id/names_en"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/names_en" />

            <Button
                android:id="@+id/names_ar"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/names_ar" />

            <Button
                android:id="@+id/names_both"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/names_both" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/bold_times"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/bold_times" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fade_passed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/fade_passed" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/text_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/text_outline" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/text_outline_help" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="20dp"
            android:text="@string/appearance_label" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/appearance_help" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/colour_name"
            style="@style/SettingsHelp" />

        <TextView
            android:id="@+id/opacity_label"
            style="@style/SettingsLabel"
            android:layout_marginTop="12dp" />

        <com.google.android.material.slider.Slider
            android:id="@+id/opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="5"
            android:valueFrom="0"
            android:valueTo="100" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="16dp"
            android:text="@string/iqamah_offset_label" />

        <Spinner
            android:id="@+id/iqamah_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsLabel"
            android:layout_marginTop="8dp"
            android:text="@string/maghrib_offset_label" />

        <Spinner
            android:id="@+id/maghrib_offset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            style="@style/SettingsHelp"
            android:text="@string/iqamah_offset_help" />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save_refresh" />

        <Button
            android:id="@+id/exact"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/allow_exact" />

        <TextView
            android:id="@+id/exact_help"
            style="@style/SettingsHelp"
            android:text="@string/allow_exact_help" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <TextView
            style="@style/SettingsHelp"
            android:layout_marginTop="16dp"
            android:text="@string/add_widget_help" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
