<?xml version="1.0" encoding="utf-8"?>
<!-- The widget is one picture drawn by WidgetRenderer; on taller widgets a real ticking
     countdown is placed over the banner (its position is set in code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/picture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_name"
        android:scaleType="fitXY" />

    <FrameLayout
        android:id="@+id/countdown_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <Chronometer
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:countDown="true"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
