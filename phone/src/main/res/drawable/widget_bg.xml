<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted dark-glass panel: translucent gradient with a light rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="270"
        android:endColor="#B8081619"
        android:startColor="#C21A3F3B" />
    <stroke
        android:width="1dp"
        android:color="#4DFFFFFF" />
</shape>
